<mxfile host="app.diagrams.net" pages="4"><diagram name="1 ResNet baseline" id="1_ResNet_baseline"><mxGraphModel dx="1400" dy="600" grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="1 · ResNet baseline (crop): joint Faster R-CNN, crops re-encoded by the shared backbone" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="36" as="geometry"/></mxCell><mxCell id="img" value="Gallery frame&lt;br&gt;256×384" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="bb" value="&lt;b&gt;Backbone&lt;/b&gt;&lt;br&gt;ResNet-50&lt;br&gt;(ImageNet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="fpn" value="&lt;b&gt;FPN&lt;/b&gt;&lt;br&gt;P2–P5, 256 ch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="rpn" value="&lt;b&gt;RPN&lt;/b&gt; &lt;font color='#b85450'&gt;*&lt;/font&gt;&lt;br&gt;objectness + box deltas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="nms" value="Top-K + NMS&lt;br&gt;≤100 proposals" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="roi" value="RoIAlign&lt;br&gt;7×7×256" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="57" width="88" height="88" as="geometry"/></mxCell><mxCell id="det" value="&lt;b&gt;Detection head&lt;/b&gt; &lt;font color='#b85450'&gt;**&lt;/font&gt;&lt;br&gt;fc6–fc7 → class + box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="dets" value="Detections&lt;br&gt;score ≥ 0.5, NMS 0.4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="crop" value="Crop &lt;b&gt;original pixels&lt;/b&gt;&lt;br&gt;resize to 128×64" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="250" width="130" height="62" as="geometry"/></mxCell><mxCell id="shared" value="&lt;b&gt;Same ResNet-50 + FPN&lt;/b&gt;&lt;br&gt;(shared weights)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="250" width="130" height="62" as="geometry"/></mxCell><mxCell id="roi2" value="RoIAlign over&lt;br&gt;whole crop&lt;br&gt;7×7×256" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="246" width="88" height="88" as="geometry"/></mxCell><mxCell id="head" value="&lt;b&gt;ReID head&lt;/b&gt; &lt;font color='#b85450'&gt;***&lt;/font&gt;&lt;br&gt;fc6–fc7 → 256-d, L2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="250" width="130" height="62" as="geometry"/></mxCell><mxCell id="emb" value="Gallery embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="250" width="130" height="62" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="img" target="bb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="C2–C5&lt;br&gt;stride 4–32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bb" target="fpn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fpn" target="rpn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rpn" target="nms"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="boxes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="nms" target="roi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="roi" target="det"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="det" target="dets"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="boxes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dets" target="crop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="second pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="crop" target="shared"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="shared" target="roi2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="roi2" target="head"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="head" target="emb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="features" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="fpn" target="roi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="425" y="48"/><mxPoint x="934" y="48"/></Array></mxGeometry></mxCell><mxCell id="notes" value="&lt;font color='#b85450'&gt;*&lt;/font&gt; RPN loss: binary cross-entropy for objectness (anchor positive if IoU ≥ 0.7 with a person GT box, negative if &lt; 0.3) + Smooth-L1 box regression on positive anchors.&lt;br&gt;&lt;font color='#b85450'&gt;**&lt;/font&gt; Detection-head loss: cross-entropy person vs background (proposal positive if IoU ≥ 0.7, negative if &lt; 0.3) + Smooth-L1 box regression on positive proposals.&lt;br&gt;&lt;font color='#b85450'&gt;***&lt;/font&gt; ReID loss: supervised NT-Xent (SupCon / InfoNCE), temperature 0.1, P×K identity batches. Positives must come from &lt;i&gt;different frames&lt;/i&gt;; GT boxes provide both the regions and the identity labels (detector proposals are not used for ReID training). Detection and ReID losses are optimised &lt;b&gt;jointly&lt;/b&gt; (one network).&lt;br&gt;&lt;b&gt;Query path:&lt;/b&gt; query crop (128×64) → same backbone + FPN → RoIAlign over the whole crop → ReID head.&lt;br&gt;&lt;b&gt;Legend:&lt;/b&gt; blue = detector, green = ReID, orange = outputs; dashed border = frozen during ReID training. The query is always a GT crop and follows the &lt;i&gt;query path&lt;/i&gt;; the ranking is cosine similarity between L2-normalised 256-d embeddings." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="395" width="1320" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Swin single-pass" id="2_Swin_single-pass"><mxGraphModel dx="1400" dy="600" grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="2 · Swin single-pass: ReID from the frozen detector's own scene features" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="36" as="geometry"/></mxCell><mxCell id="img" value="Gallery frame&lt;br&gt;512×768" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="bb" value="&lt;b&gt;Backbone&lt;/b&gt;&lt;br&gt;Swin-T&lt;br&gt;&lt;i&gt;(frozen)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="fpn" value="&lt;b&gt;FPN&lt;/b&gt;&lt;br&gt;P2–P5, 256 ch&lt;br&gt;&lt;i&gt;(frozen)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="rpn" value="&lt;b&gt;RPN&lt;/b&gt; &lt;font color='#b85450'&gt;*&lt;/font&gt;&lt;br&gt;objectness + box deltas&lt;br&gt;&lt;i&gt;(frozen)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="530" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="nms" value="Top-K + NMS&lt;br&gt;≤100 proposals" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="roi" value="RoIAlign&lt;br&gt;7×7×256" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="57" width="88" height="88" as="geometry"/></mxCell><mxCell id="det" value="&lt;b&gt;Detection head&lt;/b&gt; &lt;font color='#b85450'&gt;**&lt;/font&gt;&lt;br&gt;fc6–fc7 → class + box&lt;br&gt;&lt;i&gt;(frozen)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1040" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="dets" value="Detections&lt;br&gt;score ≥ 0.5, NMS 0.4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="roi2" value="RoIAlign on&lt;br&gt;&lt;b&gt;same&lt;/b&gt; FPN&lt;br&gt;features&lt;br&gt;7×7×256" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1231" y="237" width="88" height="88" as="geometry"/></mxCell><mxCell id="head" value="&lt;b&gt;ReID RoI head&lt;/b&gt; &lt;font color='#b85450'&gt;***&lt;/font&gt;&lt;br&gt;fc6–fc7 → 256-d, L2&lt;br&gt;(only trained part)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="250" width="130" height="62" as="geometry"/></mxCell><mxCell id="emb" value="Gallery embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="250" width="130" height="62" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="img" target="bb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="C2–C5&lt;br&gt;stride 4–32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bb" target="fpn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fpn" target="rpn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rpn" target="nms"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="boxes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="nms" target="roi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="roi" target="det"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="det" target="dets"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="boxes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dets" target="roi2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="roi2" target="head"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="head" target="emb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="features" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="fpn" target="roi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="425" y="48"/><mxPoint x="934" y="48"/></Array></mxGeometry></mxCell><mxCell id="e11" value="same pyramid reused (no second backbone pass)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="fpn" target="roi2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="425" y="355"/><mxPoint x="1275" y="355"/></Array></mxGeometry></mxCell><mxCell id="notes" value="&lt;font color='#b85450'&gt;*&lt;/font&gt; RPN loss: binary cross-entropy for objectness (anchor positive if IoU ≥ 0.7 with a person GT box, negative if &lt; 0.3) + Smooth-L1 box regression on positive anchors.&lt;br&gt;&lt;font color='#b85450'&gt;**&lt;/font&gt; Detection-head loss: cross-entropy person vs background (proposal positive if IoU ≥ 0.7, negative if &lt; 0.3) + Smooth-L1 box regression on positive proposals.&lt;br&gt;The Swin-T detector (backbone, FPN, RPN, detection head) is fine-tuned for detection only and then frozen; all three Swin systems use byte-identical detector weights.&lt;br&gt;&lt;font color='#b85450'&gt;***&lt;/font&gt; ReID loss (crop-to-scene): supervised NT-Xent (SupCon / InfoNCE), temperature 0.1, P×K identity batches. Positives must come from &lt;i&gt;different frames&lt;/i&gt;; GT boxes provide both the regions and the identity labels (detector proposals are not used for ReID training).&lt;br&gt;&lt;b&gt;Query path:&lt;/b&gt; query crop (256×128) → frozen Swin-T + FPN → RoIAlign over the whole crop → same ReID head.&lt;br&gt;&lt;b&gt;Legend:&lt;/b&gt; blue = detector, green = ReID, orange = outputs; dashed border = frozen during ReID training. The query is always a GT crop and follows the &lt;i&gt;query path&lt;/i&gt;; the ranking is cosine similarity between L2-normalised 256-d embeddings." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="395" width="1320" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Swin two-pass" id="3_Swin_two-pass"><mxGraphModel dx="1400" dy="600" grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="3 · Swin two-pass: same frozen detector + an independent Swin-T crop encoder" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="36" as="geometry"/></mxCell><mxCell id="img" value="Gallery frame&lt;br&gt;512×768" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="bb" value="&lt;b&gt;Backbone&lt;/b&gt;&lt;br&gt;Swin-T&lt;br&gt;&lt;i&gt;(frozen)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="fpn" value="&lt;b&gt;FPN&lt;/b&gt;&lt;br&gt;P2–P5, 256 ch&lt;br&gt;&lt;i&gt;(frozen)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="rpn" value="&lt;b&gt;RPN&lt;/b&gt; &lt;font color='#b85450'&gt;*&lt;/font&gt;&lt;br&gt;objectness + box deltas&lt;br&gt;&lt;i&gt;(frozen)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="530" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="nms" value="Top-K + NMS&lt;br&gt;≤100 proposals" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="roi" value="RoIAlign&lt;br&gt;7×7×256" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="57" width="88" height="88" as="geometry"/></mxCell><mxCell id="det" value="&lt;b&gt;Detection head&lt;/b&gt; &lt;font color='#b85450'&gt;**&lt;/font&gt;&lt;br&gt;fc6–fc7 → class + box&lt;br&gt;&lt;i&gt;(frozen)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1040" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="dets" value="Detections&lt;br&gt;score ≥ 0.5, NMS 0.4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="crop" value="Crop &lt;b&gt;original pixels&lt;/b&gt;&lt;br&gt;resize to 256×128" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="250" width="130" height="62" as="geometry"/></mxCell><mxCell id="enc" value="&lt;b&gt;Separate Swin-T&lt;/b&gt;&lt;br&gt;(ImageNet, last 2 stages&lt;br&gt;fine-tuned)&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="250" width="130" height="62" as="geometry"/></mxCell><mxCell id="pool" value="Pool 8×4 grid:&lt;br&gt;[global | upper | lower]&lt;br&gt;3 × 768" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="250" width="130" height="62" as="geometry"/></mxCell><mxCell id="proj" value="Linear → 256-d&lt;br&gt;L2-normalise &lt;font color='#b85450'&gt;***&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="250" width="130" height="62" as="geometry"/></mxCell><mxCell id="emb" value="Gallery embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="250" width="130" height="62" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="img" target="bb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="C2–C5&lt;br&gt;stride 4–32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bb" target="fpn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fpn" target="rpn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rpn" target="nms"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="boxes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="nms" target="roi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="roi" target="det"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="det" target="dets"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="boxes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dets" target="crop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="crop" target="enc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="enc" target="pool"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pool" target="proj"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="proj" target="emb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="features" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="fpn" target="roi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="425" y="48"/><mxPoint x="934" y="48"/></Array></mxGeometry></mxCell><mxCell id="notes" value="&lt;font color='#b85450'&gt;*&lt;/font&gt; RPN loss: binary cross-entropy for objectness (anchor positive if IoU ≥ 0.7 with a person GT box, negative if &lt; 0.3) + Smooth-L1 box regression on positive anchors.&lt;br&gt;&lt;font color='#b85450'&gt;**&lt;/font&gt; Detection-head loss: cross-entropy person vs background (proposal positive if IoU ≥ 0.7, negative if &lt; 0.3) + Smooth-L1 box regression on positive proposals.&lt;br&gt;The Swin-T detector (backbone, FPN, RPN, detection head) is fine-tuned for detection only and then frozen; all three Swin systems use byte-identical detector weights.&lt;br&gt;&lt;font color='#b85450'&gt;***&lt;/font&gt; ReID loss (crop-to-crop): supervised NT-Xent (SupCon / InfoNCE), temperature 0.1, P×K identity batches. Positives must come from &lt;i&gt;different frames&lt;/i&gt;; GT boxes provide both the regions and the identity labels (detector proposals are not used for ReID training).&lt;br&gt;&lt;b&gt;Query path:&lt;/b&gt; query crop (256×128) → the same Swin-T crop encoder.&lt;br&gt;&lt;b&gt;Legend:&lt;/b&gt; blue = detector, green = ReID, orange = outputs; dashed border = frozen during ReID training. The query is always a GT crop and follows the &lt;i&gt;query path&lt;/i&gt;; the ranking is cosine similarity between L2-normalised 256-d embeddings." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="395" width="1320" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 Swin + DINO" id="4_Swin_+_DINO"><mxGraphModel dx="1400" dy="600" grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="4 · Swin + DINO (final): same frozen detector + DINOv3 ViT-S/16 crop encoder" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="36" as="geometry"/></mxCell><mxCell id="img" value="Gallery frame&lt;br&gt;512×768" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="bb" value="&lt;b&gt;Backbone&lt;/b&gt;&lt;br&gt;Swin-T&lt;br&gt;&lt;i&gt;(frozen)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="fpn" value="&lt;b&gt;FPN&lt;/b&gt;&lt;br&gt;P2–P5, 256 ch&lt;br&gt;&lt;i&gt;(frozen)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="rpn" value="&lt;b&gt;RPN&lt;/b&gt; &lt;font color='#b85450'&gt;*&lt;/font&gt;&lt;br&gt;objectness + box deltas&lt;br&gt;&lt;i&gt;(frozen)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="530" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="nms" value="Top-K + NMS&lt;br&gt;≤100 proposals" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="roi" value="RoIAlign&lt;br&gt;7×7×256" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="57" width="88" height="88" as="geometry"/></mxCell><mxCell id="det" value="&lt;b&gt;Detection head&lt;/b&gt; &lt;font color='#b85450'&gt;**&lt;/font&gt;&lt;br&gt;fc6–fc7 → class + box&lt;br&gt;&lt;i&gt;(frozen)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1040" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="dets" value="Detections&lt;br&gt;score ≥ 0.5, NMS 0.4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="70" width="130" height="62" as="geometry"/></mxCell><mxCell id="crop" value="Crop &lt;b&gt;original pixels&lt;/b&gt;&lt;br&gt;resize to 256×128" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="250" width="130" height="62" as="geometry"/></mxCell><mxCell id="enc" value="&lt;b&gt;DINOv3 ViT-S/16&lt;/b&gt;&lt;br&gt;(self-supervised, last 4&lt;br&gt;blocks fine-tuned)&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="250" width="130" height="62" as="geometry"/></mxCell><mxCell id="pool" value="16×8 patch grid:&lt;br&gt;[CLS | upper mean | lower mean]&lt;br&gt;3 × 384" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="250" width="130" height="62" as="geometry"/></mxCell><mxCell id="proj" value="Linear → 256-d&lt;br&gt;L2-normalise &lt;font color='#b85450'&gt;***&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="250" width="130" height="62" as="geometry"/></mxCell><mxCell id="emb" value="Gallery embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="250" width="130" height="62" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="img" target="bb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="C2–C5&lt;br&gt;stride 4–32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;end